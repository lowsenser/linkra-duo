+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { loadDashboardStatus } from '../src/utils/dashboardStatus.js'
+const fixtures = {
+  '/api/status': { version: 'A0.1', uptime: 600 },
+  '/api/system': { uptime: 606, free_heap: 51856, clients: 0 },
+  '/api/wifi/status': { connected: true, mode: 'connected', ip: '192.0.2.10' },
+  '/api/rf/status': { module433: { ok: true, freq: 433.67, rssi: -73, signals: 25 }, module868: { ok: true, freq: 868.35, rssi: -100, signals: 598 } }
+}
+test('live API schemas populate memory and both receiver statuses', async () => {
+  const result = await loadDashboardStatus(async path => ({ ok: true, json: async () => fixtures[path] }))
+  assert.equal(result.systemUpdates.freeHeap, 51856)
+  assert.equal(result.systemUpdates.uptime, 606)
+  assert.equal(result.systemUpdates.wifiStatus, 'connected')
+  assert.equal(result.rfUpdates.moduleOk, true)
+  assert.equal(result.rfUpdates.currentFreq, 433.67)
+  assert.equal(result.rfUpdates.totalSignals, 623)
+})
+test('one failed API preserves other results and does not invent zero memory', async () => {
+  const result = await loadDashboardStatus(async path => ({ ok: path !== '/api/system', status: 503, json: async () => fixtures[path] }))
+  assert.equal('freeHeap' in result.systemUpdates, false)
+  assert.equal(result.rfUpdates.moduleOk, true)
+  assert.equal(result.errors.length, 1)
+})
