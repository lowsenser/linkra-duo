@@ -0,0 +1,16 @@
+/** Normalize both legacy and enriched RF messages; guesses are never decodes. */
+export function normalizeRfSignal(input, receivedAt = Date.now()) {
+  const data = { ...input, receivedAt }
+  const classified = data.status === 'classified' || data.classified === true
+  data.classified = classified
+  data.decoded = classified ? false : (data.decoded ?? Boolean(
+    data.model && data.model !== 'unknown' && !data.model.startsWith('undecoded')
+  ))
+  data.protocol ||= data.model || 'unknown'
+  const frequency = Number(data.frequency)
+  data.frequency = Number.isFinite(frequency) && frequency > 0 ? frequency : null
+  // A band identifies a receiver, not its exact tuned frequency.
+  data.band = data.band != null ? String(data.band) :
+    (data.frequency == null ? null : (data.frequency > 800 ? '868' : '433'))
+  return data
+}
