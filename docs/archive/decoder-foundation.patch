+export async function loadDashboardStatus(fetcher = fetch) {
+  const paths = ['/api/status', '/api/system', '/api/wifi/status', '/api/rf/status']
+  const results = await Promise.allSettled(paths.map(async path => {
+    const response = await fetcher(path)
+    if (!response.ok) throw new Error(`${path}: HTTP ${response.status}`)
+    return response.json()
+  }))
+  const [version, system, wifi, rf] = results.map(r => r.status === 'fulfilled' ? r.value : null)
+  const systemUpdates = {}
+  const rfUpdates = {}
+  if (version?.version != null) systemUpdates.firmwareVersion = version.version
+  if (system) {
+    if (system.uptime != null) systemUpdates.uptime = system.uptime
+    if (system.free_heap != null) systemUpdates.freeHeap = system.free_heap
+    if (system.clients != null) systemUpdates.wifiClients = system.clients
+  }
+  if (wifi) {
+    systemUpdates.wifiStatus = wifi.mode ?? 'unknown'
+    systemUpdates.ip = wifi.connected ? wifi.ip : (wifi.mode === 'setup_ap' ? wifi.ap_ip : null)
+  }
+  if (rf?.module433 && rf?.module868) {
+    rfUpdates.moduleOk = rf.module433.ok && rf.module868.ok
+    rfUpdates.module433 = rf.module433
+    rfUpdates.module868 = rf.module868
+    rfUpdates.currentFreq = rf.module433.freq
+    rfUpdates.currentRSSI = rf.module433.rssi
+    rfUpdates.totalSignals = rf.module433.signals + rf.module868.signals
+  }
+  return { systemUpdates, rfUpdates, errors: results.filter(r => r.status === 'rejected').map(r => r.reason.message) }
+}
