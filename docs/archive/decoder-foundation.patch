+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { normalizeRfSignal } from '../src/utils/rfSignal.js'
+import { getDeviceId, addOrUpdateDevice, devices } from '../src/signals/devices.js'
+
+test('legacy 868 MHz unknown burst is never shown as a decoded 433 MHz device', () => {
+  const signal = normalizeRfSignal({ model: '868 MHz Gerät', status: 'classified', band: '868' }, 1000)
+  assert.equal(signal.decoded, false)
+  assert.equal(signal.classified, true)
+  assert.equal(signal.band, '868')
+  assert.equal(signal.frequency, null)
+})
+test('an explicit classification overrides an erroneous decoded flag', () => {
+  assert.equal(normalizeRfSignal({ model: 'Wettersensor', status: 'classified', decoded: true }).decoded, false)
+})
+test('valid ID zero does not merge unrelated models and retains later sensor updates', () => {
+  devices.value = new Map()
+  const first = normalizeRfSignal({ model: 'SensorA', id: 0, frequency: 868.35, temperature_C: 7.2 })
+  addOrUpdateDevice(first)
+  addOrUpdateDevice(normalizeRfSignal({ model: 'SensorB', id: 0, frequency: 433.92, temperature_C: 20 }))
+  addOrUpdateDevice({ ...first, temperature_C: 7.3 })
+  assert.equal(getDeviceId(first), 'SensorA_0')
+  assert.equal(devices.value.size, 2)
+  assert.equal(devices.value.get('SensorA_0').temperature_C, 7.3)
+  assert.equal(devices.value.get('SensorA_0').count, 2)
+})
+test('a valid LaCrosse message retains frequency, measurements and ID', () => {
+  const signal = normalizeRfSignal({ model: 'LaCrosse-TX29IT', id: 25, frequency: 868.35, temperature_C: 7.2, humidity: 77 })
+  assert.equal(signal.decoded, true)
+  assert.equal(signal.band, '868')
+  assert.equal(signal.frequency, 868.35)
+  assert.equal(signal.humidity, 77)
+})
+test('missing and invalid frequency remain unknown', () => {
+  for (const frequency of [undefined, null, '', 'bad', 0, -1]) {
+    assert.equal(normalizeRfSignal({ frequency }).frequency, null)
+  }
+  assert.equal(normalizeRfSignal({ model: 'unknown' }).decoded, false)
+})
